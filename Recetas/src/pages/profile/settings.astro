---
import "@/styles/global.css";
import Footer from '@/shared/layout/Footer';
import Navbar from '@/shared/layout/Navbar';
import SettingsPage from '@/features/settings/components/SettingsPage';
import BaseHead from '@/shared/layout/BaseHead.astro';
---

<html lang="es">
<head>
    <BaseHead title="Ajustes de Cuenta - ChileBite" description="Modifica tus ajustes de cuenta y preferencias en ChileBite." />
</head>
<body class="transition-colors duration-300 min-h-screen flex flex-col">
    <Navbar client:only="react" />
    <main class="flex-grow min-h-[calc(100vh-80px)]">
        <SettingsPage client:only="react">
            <div slot="fallback" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-28 pb-20 animate-pulse space-y-8">
                <div class="space-y-3">
                    <div class="w-48 h-8 rounded-xl bg-surface-muted dark:bg-zinc-800"></div>
                    <div class="w-64 h-4 rounded-lg bg-surface-muted dark:bg-zinc-800"></div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <div class="h-64 rounded-2xl bg-surface-muted dark:bg-zinc-800"></div>
                    <div class="md:col-span-2 h-96 rounded-2xl bg-surface-muted dark:bg-zinc-800"></div>
                </div>
            </div>
        </SettingsPage>
    </main>
    <Footer/>
</body>
</html>
