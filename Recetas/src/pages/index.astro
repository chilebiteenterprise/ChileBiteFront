---
import "@/styles/global.css";
import Footer from "@/shared/layout/Footer";
import Navbar from "@/shared/layout/Navbar";
import BaseHead from "@/shared/layout/BaseHead.astro";

import HeroSection from "@/components/home/HeroSection";
import ValuePropsSection from "@/components/home/ValuePropsSection";
import CalculatorPreviewSection from "@/components/home/CalculatorPreviewSection";
import GallerySection from "@/components/home/GallerySection";
import CommunitySection from "@/components/home/CommunitySection";
import BusinessCTASection from "@/components/home/BusinessCTASection";
---

<html lang="es">
  <head>
    <BaseHead
      title="ChileBite – Descubre, Aprende y Comparte la Gastronomía Chilena"
      description="Explora las mejores recetas chilenas paso a paso, calcula macronutrientes con Inteligencia Artificial, descubre restaurantes locales y conéctate con la comunidad gastronómica."
      preloadImage="/images/Titulo.webp"
    />
  </head>

  <body
    class="bg-[#111317] text-zinc-100 selection:bg-[#c89a74] selection:text-[#1c1208] transition-colors duration-300 antialiased overflow-x-hidden min-h-screen flex flex-col justify-between"
  >
    <Navbar client:only="react" />

    <main class="flex-grow bg-[#111317]">
      <HeroSection client:load />
      <ValuePropsSection client:visible />
      <CalculatorPreviewSection client:visible />
      <GallerySection client:visible />
      <CommunitySection client:visible />
      <!-- <BusinessCTASection client:visible /> -->
    </main>

    <Footer client:visible />
  </body>
</html>
