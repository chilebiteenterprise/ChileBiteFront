---
import "@/styles/global.css";
import Navbar from "@/shared/layout/Navbar";
import Footer from "@/shared/layout/Footer";
import BaseHead from "@/shared/layout/BaseHead.astro";
---

<html lang="es">
  <head>
    <BaseHead
      title="404 - Receta no encontrada | ChileBite"
      description="Lo sentimos, no pudimos encontrar el plato que buscas."
      robots="noindex, follow"
    />

    <style is:global>
      /* Floating animation for the cloche dome */
      @keyframes dome-float {
        0%,
        100% {
          transform: translateY(0) rotate(0deg);
        }
        50% {
          transform: translateY(-24px) rotate(-10deg);
        }
      }

      /* Steam rising and fading */
      @keyframes steam-rise {
        0% {
          transform: translateY(15px) scaleX(0.8);
          opacity: 0;
        }
        25% {
          opacity: 0.6;
        }
        75% {
          opacity: 0.6;
        }
        100% {
          transform: translateY(-25px) scaleX(1.3);
          opacity: 0;
        }
      }

      /* 404 text reveal sync */
      @keyframes text-reveal {
        0%,
        100% {
          opacity: 0.15;
          transform: scale(0.9);
          filter: blur(1px);
        }
        50% {
          opacity: 1;
          transform: scale(1);
          filter: blur(0);
        }
      }

      /* Smooth cloche open-and-release animation */
      @keyframes cloche-open-click {
        0% { transform: translateY(0) rotate(0deg); }
        30% { transform: translateY(-38px) rotate(-18deg); }
        55% { transform: translateY(-35px) rotate(-16deg); }
        100% { transform: translateY(0) rotate(0deg); }
      }

      /* Elegant aroma particles floating upwards */
      @keyframes aroma-float {
        0% {
          transform: translate(-50%, -50%) translate(0, 0) scale(0.4);
          opacity: 0;
          filter: blur(2px);
        }
        20% {
          opacity: 0.8;
          filter: blur(3px);
        }
        100% {
          transform: translate(-50%, -50%) translate(var(--x), var(--y)) scale(1.8);
          opacity: 0;
          filter: blur(8px);
        }
      }

      /* Expanding radial aroma shockwave */
      @keyframes pulse-ring {
        0% {
          transform: scale(0.6);
          opacity: 0.8;
        }
        100% {
          transform: scale(1.6);
          opacity: 0;
        }
      }

      .animate-dome {
        transform-origin: 100px 125px;
        animation: dome-float 4.5s ease-in-out infinite;
      }

      .animate-steam {
        animation: steam-rise 4.5s ease-in-out infinite;
      }

      .animate-text-reveal {
        transform-origin: 100px 115px;
        animation: text-reveal 4.5s ease-in-out infinite;
      }

      .animate-open-click {
        transform-origin: 100px 125px;
        animation: cloche-open-click 1s cubic-bezier(0.25, 1, 0.5, 1) both !important;
      }

      .aroma-ring {
        position: absolute;
        width: 140px;
        height: 140px;
        border: 2.5px solid #bc8a5f;
        border-radius: 50%;
        pointer-events: none;
        left: calc(50% - 70px);
        top: calc(60% - 70px);
        z-index: 30;
        animation: pulse-ring 0.8s cubic-bezier(0.1, 0.8, 0.2, 1) forwards;
      }

      .aroma-particle {
        position: absolute;
        left: 50%;
        top: 60%;
        border-radius: 50%;
        pointer-events: none;
        z-index: 40;
        animation: aroma-float 1.2s cubic-bezier(0.1, 0.8, 0.2, 1) forwards;
      }

      .delay-1 {
        animation-delay: 1.2s;
      }

      .delay-2 {
        animation-delay: 2.4s;
      }
    </style>
  </head>
  <body
    class="transition-colors duration-300 min-h-screen flex flex-col"
  >
    <Navbar client:only="react" />

    <main
      class="flex-grow flex items-center justify-center px-4 py-16 md:py-24 relative overflow-hidden"
    >
      <!-- Glow background effects -->
      <div
        class="absolute -top-40 -left-40 w-96 h-96 bg-copper-300/10 dark:bg-copper-900/5 rounded-full blur-[120px] pointer-events-none"
      >
      </div>
      <div
        class="absolute -bottom-40 -right-40 w-96 h-96 bg-copper-500/10 dark:bg-copper-800/5 rounded-full blur-[120px] pointer-events-none"
      >
      </div>

      <!-- Main card container (Glassmorphic) -->
      <div
        class="relative z-10 w-full max-w-xl mx-auto px-8 py-12 md:p-16 rounded-[2.5rem] premium-glass-wrapper border border-gray-250/50 dark:border-gray-800/30 shadow-2xl text-center"
      >
        <!-- Illustration Area -->
        <div
          id="cloche-container"
          class="w-56 h-56 mx-auto mb-8 relative flex items-center justify-center"
        >
          <svg
            viewBox="0 0 200 200"
            class="w-full h-full text-copper-500 dark:text-copper-400"
            fill="none"
            stroke="currentColor"
            stroke-width="4.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <!-- Sparkles/Floating micro-elements -->
            <path
              d="M25 45 L29 49 M175 55 L171 51 M30 135 L26 139"
              stroke="currentColor"
              stroke-opacity="0.3"
              stroke-width="2.5"></path>
            <circle
              cx="165"
              cy="120"
              r="2"
              fill="currentColor"
              fill-opacity="0.3"></circle>
            <circle cx="45" cy="25" r="2" fill="currentColor" fill-opacity="0.3"
            ></circle>

            <!-- Steam/Aroma waves rising from the open cloche -->
            <g class="text-copper-400 dark:text-copper-300/70">
              <path d="M55 90 Q50 78 55 66 T55 45" class="animate-steam"></path>
              <path
                d="M145 90 Q150 78 145 66 T145 45"
                class="animate-steam delay-1"></path>
              <path d="M100 35 Q105 25 100 15" class="animate-steam delay-2"
              ></path>
            </g>

            <!-- Plate / Serving Tray -->
            <path
              d="M25 129 C25 129 30 135 100 135 C170 135 175 129 175 129"
              stroke-width="5"
              fill="currentColor"
              fill-opacity="0.1"></path>
            <line x1="15" y1="129" x2="185" y2="129" stroke-width="6"></line>

            <!-- Elegant 404 Text revealed on the tray -->
            <text
              x="100"
              y="118"
              text-anchor="middle"
              font-family="system-ui, -apple-system, sans-serif"
              font-weight="900"
              font-size="36"
              fill="currentColor"
              stroke="none"
              class="animate-text-reveal font-inter">404</text
            >

            <!-- Tilted Cloche (Dome Cover) -->
            <g
              class="animate-dome cursor-pointer group/dome"
              id="cloche-dome"
              style="outline: none;"
            >
              <!-- Dome handle -->
              <circle
                cx="100"
                cy="50"
                r="7"
                fill="currentColor"
                fill-opacity="0.2"
                stroke-width="4.5"></circle>
              <path d="M95 56 L105 56" stroke-width="5"></path>

              <!-- Dome body -->
              <path
                d="M100 58 C60 58 45 85 45 125 L155 125 C155 85 140 58 100 58 Z"
                fill="currentColor"
                fill-opacity="0.05"></path>
              <path d="M45 125 L155 125" stroke-width="2"></path>
            </g>
          </svg>
        </div>

        <!-- Text/Error Information -->
        <h1
          class="text-3xl md:text-4xl font-extrabold text-gray-900 dark:text-white tracking-tight mb-4 font-inter"
        >
          Plato no disponible
        </h1>
        <p
          class="text-base text-gray-600 dark:text-gray-400 max-w-sm mx-auto mb-10 leading-relaxed font-inter"
        >
          La receta o página que buscas no se encuentra en el menú actual. Tal
          vez se haya cambiado de sección o eliminado.
        </p>

        <!-- Modern, Minimalist Link -->
        <div>
          <a
            href="/"
            class="inline-flex items-center space-x-2 text-copper-500 hover:text-copper-600 dark:text-copper-400 dark:hover:text-copper-300 font-extrabold tracking-wide transition-colors duration-200 group font-inter"
          >
            <span>Volver a la mesa</span>
            <span
              class="transform transition-transform duration-200 group-hover:translate-x-1"
              >→</span
            >
          </a>
        </div>
      </div>
    </main>

    <Footer client:only="react" />

    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        const clocheDome = document.getElementById("cloche-dome");
        const container = document.getElementById("cloche-container");
        const colors = ["#bc8a5f", "#d4a373", "#eabe9b", "#b08969"];

        if (clocheDome && container) {
          clocheDome.addEventListener("click", () => {
            // Trigger smooth click open-release animation
            clocheDome.classList.add("animate-open-click");

            // Remove class after animation finishes (1000ms)
            setTimeout(() => {
              clocheDome.classList.remove("animate-open-click");
            }, 1000);

            // Spawn aroma ring pulse
            const ring = document.createElement("div");
            ring.className = "aroma-ring";
            container.appendChild(ring);
            setTimeout(() => ring.remove(), 800);

            // Spawn dynamic aroma steam particles
            const particleCount = 12;
            for (let i = 0; i < particleCount; i++) {
              const particle = document.createElement("div");
              particle.className = "aroma-particle";
              
              // Assign random warm copper color
              const color = colors[Math.floor(Math.random() * colors.length)];
              particle.style.backgroundColor = color;
              
              // Variable sizing
              const size = 8 + Math.random() * 12;
              particle.style.width = `${size}px`;
              particle.style.height = `${size}px`;

              // Random physics (moving upwards in wave)
              const angle = Math.PI + (Math.random() - 0.5) * 1.2; // angled upwards
              const distance = 80 + Math.random() * 100;
              const x = Math.cos(angle) * distance;
              const y = Math.sin(angle) * distance - 20; // moving up
              
              particle.style.setProperty("--x", `${x}px`);
              particle.style.setProperty("--y", `${y}px`);

              container.appendChild(particle);

              // Auto clean up
              setTimeout(() => {
                particle.remove();
              }, 1200);
            }
          });
        }
      });
    </script>
  </body>
</html>
