---
import "@/styles/global.css";
import Footer from '@/shared/layout/Footer';
import Navbar from '@/shared/layout/Navbar';
import IngredientManagerComponent from '@/features/admin/components/IngredientManager';
import BaseHead from '@/shared/layout/BaseHead.astro';
---


<html lang="es">
  <head>
    <BaseHead title="Gestor de Ingredientes - ChileBite" description="Administración de ingredientes y valores nutricionales." />
  </head>
  <body class="bg-bg-page text-text-main transition-colors duration-300 overflow-x-hidden min-h-screen flex flex-col">
    <!-- Navbar Absolute => Pushes content with mt-20 -->
    <Navbar client:only="react" />
    <main class="flex-grow pt-20 pb-5 min-h-[calc(100vh-80px)]">
        <div class="py-4">
            <IngredientManagerComponent client:only="react" />
        </div>
    </main>
    <Footer/>
  </body>
</html>
