---
import "@/styles/global.css";
import Footer from '@/shared/layout/Footer';
import Navbar from '@/shared/layout/Navbar';
import RecipeEditorComponent from '@/features/recipes/components/RecipeEditor';
import BaseHead from '@/shared/layout/BaseHead.astro';
---


<html lang="es">
  <head>
    <BaseHead title="Creación de Recetas - ChileBite" description="Panel de creación y edición de recetas para ChileBite." />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght@100..700,0..1,-50..200&display=swap" rel="stylesheet" />
  </head>
  <body class="font-['Inter'] transition-colors duration-300 antialiased min-h-screen flex flex-col">
    <Navbar client:only="react" />
    <!-- Wrapper normal debajo del navbar -->
    <main class="mt-20 flex-1 min-h-[calc(100vh-80px)]">
        <div class="py-12">
            <RecipeEditorComponent client:only="react">
                <div slot="fallback" class="w-full flex flex-col items-center justify-center p-20 animate-pulse text-text-muted">
                    <div class="w-12 h-12 border-4 border-border-subtle border-t-brand-primary dark:border-t-[#f0a262] rounded-full animate-spin mb-4"></div>
                    <p class="font-bold text-sm tracking-widest uppercase text-text-muted">Cargando editor de recetas...</p>
                </div>
            </RecipeEditorComponent>
        </div>
    </main>
    <Footer client:visible />
  </body>
</html>
